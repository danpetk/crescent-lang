func collatz(n : i64) : i64 {
    let steps : i64 = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = n * 3 + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

func main() : i64 {
    let i : i64 = 1;
    while i <= 10 {
        print("collatz({}) takes {} steps\n", i, collatz(i));
        i = i + 1;
    }
    return 0;
}
