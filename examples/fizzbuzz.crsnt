func fizzbuzz(x: i64) : i64 {
    print("{}: ", x);
    if x % 3 == 0 {
        print("Fizz");    
    }
    if x % 5 == 0 {
        print("Buzz");
    }

    print("\n");

    return 0;
}

func main() : i64 {
    let n : i64 = 100;
    let i : i64 = 1;

    while i <= n {
        fizzbuzz(i);
        i = i + 1;
    }

    return 0;
}

