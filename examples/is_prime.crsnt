func is_prime(n : i64) : i64 {
    if n < 2 {
        return 0;
    }

    let i: i64 = 2;
    while i * i <= n {
        if n % i == 0 {
            return 0;
        }
        i = i + 1;
    }
   
    return 1;
}

func main() : i64 {
    let n : i64 = 998244353;
    if is_prime(n) {
        print("The number n = {} is prime!\n", n);
    } else {
        print("The number n = {} is not prime!\n", n);
    }
    return 0;
}

