func is_prime(n : i64) : i64 {
    if n < 2 {
        return 0;
    }

    let i: i64 = 2;
    while i * i <= n {
        if n - (n / i) * i == 0 {
            return 0;
        }
        i = i + 1;
    }
   
    return 1;
}

func test(n : i64) : i64 {
    return n % 3;
}

func main() : i64 {
    // return test(1,2,3,4,5,6,7);
    return test(7);
    return is_prime(998244353);
}


